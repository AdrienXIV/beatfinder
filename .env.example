# Spotify Developer credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth redirect URI (DOIT matcher exactement celle déclarée dans l'app Spotify).
# Si tu changes le port, change-le aussi côté Dashboard Spotify.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# (Optionnel) Chemin du cache token OAuth
SPOTIFY_CACHE_PATH=.spotify_cache

# Chemin de stockage local (audio cache + analyses.db)
DATA_DIR=./data

# Niveau de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Optionnel : cookies YouTube exportés en format Netscape (cookies.txt) pour
# contourner certains blocages géo / âge. Laisse vide si pas besoin.
YT_DLP_COOKIES_FILE=
